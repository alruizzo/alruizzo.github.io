```{=html}
<% const T = Object.assign({}, (typeof templateParams !== "undefined" && templateParams && templateParams.t) || {}); const S = Object.assign({ joint: "joint publications", to: "to" }, T); %>
<ul class="list rr-coauthors">
<% for (const item of items) { %>
<li class="rr-coauthor" <%= metadataAttrs(item) %>><span class="rr-coauthor-name"><%- item.name %></span><span class="rr-coauthor-meta rr-num"><%- item.joint %> <%- S.joint %> · <%- item.first_year === item.last_year ? item.first_year : item.first_year + " " + S.to + " " + item.last_year %></span></li>
<% } %>
</ul>
```
