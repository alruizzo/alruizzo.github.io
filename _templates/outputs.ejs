```{=html}
<div class="list rr-grid rr-grid-3">
<% for (const item of items) { %>
<article class="rr-card rr-card-quiet" <%= metadataAttrs(item) %>>
<span class="rr-eyebrow"><%- item.kind %> · <%- item.repository %> · <span class="rr-num"><%- item.year %></span></span>
<h3><a href="<%= item.url %>"><%- item.title %></a></h3>
<% if (item.description) { %><p><%- item.description %></p><% } %>
<div class="rr-card-foot">
<% if (item.related) { %><a href="publications.html#pub-<%= item.related %>">Related publication</a> · <% } %>
<a href="https://doi.org/<%= item.doi %>" aria-label="DOI for <%- item.title %>">DOI</a><% if (item.license) { %> · <%- item.license %><% } %>
</div>
</article>
<% } %>
</div>
```
