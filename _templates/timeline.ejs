```{=html}
<ol class="list rr-timeline">
<% for (const item of items) { %>
<li class="rr-timeline-item" <%= metadataAttrs(item) %>>
<div class="rr-when rr-num"><%- item.period %></div>
<div>
<p class="rr-item-title"><%- item.title %></p>
<% if (item.org) { %><p class="rr-org"><%- item.org %><% if (item.place) { %>, <%- item.place %><% } %></p><% } %>
<% if (item.detail) { %><p class="rr-detail"><%- item.detail %></p><% } %>
<% if (item.amount) { %><p class="rr-detail rr-num">Funding: <%- item.amount %></p><% } %>
<% if (item.links) { %><p class="rr-detail rr-links"><% for (const [i, l] of item.links.entries()) { %><%= i ? " · " : "" %><a href="<%= l.url %>"><%- l.label %></a><% } %></p><% } %>
<% if (item.grant_url) { %><p class="rr-detail"><a href="<%= item.grant_url %>"><%- item.programme %>, grant <%- item.grant %></a></p><% } %>
<% const logos = (item.funder_list || []).filter((f) => f.logo); if (logos.length) { %><% partial('_funder-marks.ejs.md', { funders: logos, small: true }) %><% } %>
</div>
</li>
<% } %>
</ol>
```
